# Mode: demo or live (docs/10). Without ANTHROPIC_API_KEY, live falls back to demo.
UXC_MODE=demo

# Live mode only. Read on the server only. Never add this to Vercel.
ANTHROPIC_API_KEY=

# Model id, change without code changes
UXC_MODEL=claude-sonnet-5-5

# Timeout per Claude call, in milliseconds
UXC_TIMEOUT_MS=60000

# Optional: euros per million tokens, for the spend line on My checklist
UXC_PRICE_INPUT_PER_M=
UXC_PRICE_OUTPUT_PER_M=

# 1 = use lib/fake-ai.ts fixtures, no network
UXC_FAKE_AI=0
