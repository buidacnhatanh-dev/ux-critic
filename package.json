{
  "name": "ux-critic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "next build && node scripts/check-demo-build.ts",
    "check:demo-build": "node scripts/check-demo-build.ts",
    "start": "next start",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "demo:capture": "node scripts/demo-capture.ts",
    "demo:data": "node scripts/demo-data.ts",
    "demo:og": "node scripts/og-capture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/overpass": "^5.3.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tesseract.js": "7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.x"
  }
}
